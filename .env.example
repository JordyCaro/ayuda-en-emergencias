# Variables de entorno — copiar a `.env` en la raíz (no subir secretos)

# Database (docker-compose local)
DATABASE_URL=postgresql://aee:aee@localhost:5432/ayuda_emergencias
POSTGRES_USER=aee
POSTGRES_PASSWORD=aee
POSTGRES_DB=ayuda_emergencias
POSTGRES_PORT=5432

# Backend
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
NODE_ENV=development

# Connectors (opcional)
IDEAM_POLL_CRON=0 */15 * * * *

# Moderación ops (API /moderation — sin UI ciudadana)
MODERATION_TOKEN=dev-moderation-token-change-me

# Ops connectors (obligatorio en NODE_ENV=production)
OPS_TOKEN=dev-ops-token-change-me

# TypeORM
# TYPEORM_SYNCHRONIZE=false
# TYPEORM_MIGRATIONS_RUN=true
# TYPEORM_LOGGING=true
# OPENAPI_EXPORT=true
