# Variables de entorno — copiar a `.env` en la raíz (no subir secretos)

# Database (docker-compose local)
DATABASE_URL=postgresql://aee:aee@localhost:5432/ayuda_emergencias
POSTGRES_USER=aee
POSTGRES_PASSWORD=aee
POSTGRES_DB=ayuda_emergencias
POSTGRES_PORT=5432

# Backend
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
NODE_ENV=development

# Connectors (opcional)
IDEAM_POLL_CRON=0 */15 * * * *

# Moderación (Fase 9) — header X-Moderation-Token en /api/v1/moderation/*
MODERATION_TOKEN=dev-moderation-token-change-me
